
SDKWORK_MEMORY_DEPLOYMENT_PROFILE=standalone
SDKWORK_MEMORY_ENVIRONMENT=production
SDKWORK_MEMORY_CONFIG_PROFILE=production
SDKWORK_MEMORY_RUNTIME_TARGET=container
SDKWORK_MEMORY_PROFILE_ID=cloud.production


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_LLM_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_MEMORY_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:8080
SDKWORK_MEMORY_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:8080
SDKWORK_MEMORY_APPLICATION_BACKEND_HTTP_BIND=127.0.0.1:8080
SDKWORK_MEMORY_APPLICATION_BACKEND_HTTP_URL=http://127.0.0.1:8080
SDKWORK_MEMORY_APPLICATION_OPEN_HTTP_BIND=127.0.0.1:8080
SDKWORK_MEMORY_APPLICATION_OPEN_HTTP_URL=http://127.0.0.1:8080
SDKWORK_MEMORY_APPLICATION_APP_HTTP_BIND=127.0.0.1:8080
SDKWORK_MEMORY_APPLICATION_APP_HTTP_URL=http://127.0.0.1:8080

SDKWORK_MEMORY_TENANT_ID=100001
SDKWORK_MEMORY_USER_ID=9001
SDKWORK_MEMORY_DEV_AUTH_BYPASS=true
SDKWORK_MEMORY_SNOWFLAKE_NODE_ID=1

SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=db.example.com
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_prod
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_prod
SDKWORK_DATABASE_USERNAME=sdkwork_ai_prod
SDKWORK_DATABASE_PASSWORD_FILE=/run/secrets/sdkwork/database-password
SDKWORK_DATABASE_SSL_MODE=require
